# Salin ke .e2e.env (gitignored) lalu isi. Playwright menyalakan binary release
# (../../target/release/whisker) lewat `webServer` bila belum ada server di E2E_BASE_URL.
E2E_BASE_URL=http://127.0.0.1:8080
# DB dev yang SAMA dengan monolith (db-whisker, keputusan owner Q8). Harness hanya membuat dan
# menghapus user `e2e+<run-id>-…@example.test` + vault miliknya; tanpa TRUNCATE/reset.
E2E_DATABASE_URL=postgres://<user>:<password>@localhost:5432/db-whisker
# Password semua user seed (minimal 12 karakter).
E2E_USER_PASSWORD=<min-12-karakter>
# Opsional — admin bootstrap bila tabel users kosong (ruling K5); diteruskan sebagai
# WHISKER_ADMIN_EMAIL / WHISKER_ADMIN_PASSWORD ke binary.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
