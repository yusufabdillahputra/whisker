# Whisker — template konfigurasi. Salin ke `.env` (gitignored) lalu isi nilainya.
# PostgreSQL & MinIO TIDAK dibundel di docker-compose.yml — arahkan ke instance milik developer.
# Dari dalam container, mesin host = host.docker.internal.

# HTTP (web UI + endpoint MCP Streamable HTTP)
WHISKER_HTTP_ADDR=0.0.0.0:8080
WHISKER_PUBLIC_URL=http://localhost:8080

# PostgreSQL — database: db-whisker
DATABASE_URL=postgres://<user>:<password>@host.docker.internal:5432/db-whisker

# MinIO / S3 — aset & artefak graph
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_BUCKET=whisker
MINIO_REGION=us-east-1
