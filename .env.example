# Whisker — template konfigurasi. Salin ke `.env` (gitignored) lalu isi nilainya.
# PostgreSQL & object storage TIDAK dibundel di docker-compose.yml — arahkan ke instance milik developer.
# Dev lokal: dari dalam container, mesin host = host.docker.internal. Production: Neon + object storage S3-compatible.

# HTTP (web UI + endpoint MCP Streamable HTTP)
WHISKER_HTTP_ADDR=0.0.0.0:8080
WHISKER_PUBLIC_URL=http://localhost:8080

# PostgreSQL — database: db-whisker (Neon: tambahkan ?sslmode=require)
DATABASE_URL=postgres://<user>:<password>@host.docker.internal:5432/db-whisker

# Object storage S3-compatible — aset & artefak graph (dev: MinIO; production: object storage terkelola)
S3_ENDPOINT=http://host.docker.internal:9000
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_BUCKET=whisker
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
