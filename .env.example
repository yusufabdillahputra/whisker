# Whisker — template konfigurasi. Salin ke `.env` (gitignored) lalu isi nilainya.
# PostgreSQL & object storage TIDAK dibundel di docker-compose.yml — arahkan ke instance milik developer.
# Dev lokal: dari dalam container, mesin host = host.docker.internal. Production: Neon + object storage S3-compatible.

# HTTP (web UI + endpoint MCP Streamable HTTP)
WHISKER_HTTP_ADDR=0.0.0.0:8080
WHISKER_PUBLIC_URL=http://localhost:8080
# Cookie Secure (default true; false hanya untuk HTTP non-loopback). Chrome menerima Secure di localhost/127.0.0.1.
WHISKER_COOKIE_SECURE=true
# Daftar CIDR proxy tepercaya, dipisah koma. Kosong (default) = X-Forwarded-For TIDAK dipercaya.
WHISKER_TRUSTED_PROXIES=

# Bootstrap admin pertama: WAJIB bila tabel users kosong (start gagal cepat tanpa keduanya atau bila masih
# placeholder); password minimal 12 karakter, dibaca apa adanya (tanpa trim). Admin dibuat dengan wajib
# ganti password. Setelah admin ada, env ini diabaikan — hapus password dari env (ada peringatan di log).
# WHISKER_ADMIN_EMAIL=
# WHISKER_ADMIN_PASSWORD=

# Hanya dev: Vite dev server (HMR). Kosongkan untuk memakai aset ter-embed.
# WHISKER_VITE_DEV_SERVER=http://localhost:5173

# PostgreSQL — database: db-whisker (Neon: tambahkan ?sslmode=require)
DATABASE_URL=postgres://<user>:<password>@host.docker.internal:5432/db-whisker

# Object storage S3-compatible — aset & artefak graph (dev: MinIO; production: object storage terkelola)
S3_ENDPOINT=http://host.docker.internal:9000
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_BUCKET=whisker
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
